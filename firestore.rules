rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny access to unauthorized collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user ownership: Each authenticated user can only access their own documents & subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
